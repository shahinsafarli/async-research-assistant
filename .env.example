# ================================================================
# Async Research Assistant — environment variables
# Copy this to .env and fill in real values. DO NOT commit .env.
# ================================================================

# --- LLM provider (synthesis) ---
LLM_PROVIDER=anthropic          # anthropic | openai | gemini
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Web search provider ---
WEB_SEARCH_PROVIDER=tavily      # tavily | serper | duckduckgo
TAVILY_API_KEY=                 # https://tavily.com — free 1000 req/month
# SERPER_API_KEY=               # https://serper.dev — free 2500 req
# (DuckDuckGo needs no key — install duckduckgo-search package)

# --- App behaviour ---
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
MAX_CONCURRENT=5                # semaphore bound for parallel fetches
CACHE_TTL_SECONDS=3600          # 1 hour; 0 = never expire
CACHE_DIR=./.cache
SOURCE_RATE_LIMIT_SECONDS=0.2   # minimum delay between live calls per source

# --- Per-source timeouts (seconds) ---
WIKIPEDIA_TIMEOUT=10.0
ARXIV_TIMEOUT=30.0
ARXIV_RATE_LIMIT_SECONDS=3.0
ARXIV_CONTACT_EMAIL=you@example.com
WEB_TIMEOUT=10.0

# --- Query limits ---
MAX_SOURCES_PER_QUERY=3
MAX_QUESTION_LENGTH=1000

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./researcher.db
